# Same connection string as the CLI's .env in the parent directory — this app
# only reads the tables the CLI writes to.
DATABASE_URL=

# Shared password gating the whole dashboard. This shows personal/university
# inbox summaries on a public URL, so it isn't deployed fully open.
DASHBOARD_PASSWORD=

# Any long random string, used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
