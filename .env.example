# Timezone used for interpreting relative deadlines and formatting report dates.
TIMEZONE=Australia/Sydney

# Your own mailbox address, used to detect emails sent directly to you (vs. Cc'd or on a list).
USER_EMAIL=you@example.edu.au

# Comma-separated list of addresses treated as "manager" senders for scoring,
# in addition to whatever the AI classifier infers as senderRole=manager.
MANAGER_EMAILS=

# --- Microsoft Entra ID app registration (delegated permissions, public client) ---
# Only needed for --provider outlook. Register an app at https://entra.microsoft.com,
# enable "Allow public client flows", and grant delegated scopes: openid, profile,
# offline_access, User.Read, Mail.Read. Do NOT request Mail.ReadWrite or Mail.Send.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# --- Google Cloud OAuth client (device flow) ---
# Only needed for --provider gmail. In Google Cloud Console: enable the Gmail API,
# configure the OAuth consent screen (External, Testing is fine for personal use,
# add your own Gmail address as a test user), then create an OAuth client ID of
# type "TVs and Limited Input devices" (this is what enables the device flow).
# Grant only the read-only scope: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
