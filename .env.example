# Timezone used for interpreting relative deadlines and formatting report dates.
TIMEZONE=Australia/Sydney

# Your own mailbox address, used to detect emails sent directly to you (vs. Cc'd or on a list).
USER_EMAIL=you@example.edu.au

# Comma-separated list of addresses treated as "manager" senders for scoring,
# in addition to whatever the AI classifier infers as senderRole=manager.
MANAGER_EMAILS=

# --- Database (shared with the web dashboard in web/) ---
# A hosted Postgres connection string, e.g. from https://neon.tech (free tier).
# Not needed for --mock runs (see src/db/mock-store.ts). Required for real runs —
# run `npm run db:push` once (after setting this) to create the tables.
DATABASE_URL=

# --- Microsoft Entra ID app registration (delegated permissions, public client) ---
# Only needed for --provider outlook. Register an app at https://entra.microsoft.com,
# enable "Allow public client flows", and grant delegated scopes: openid, profile,
# offline_access, User.Read, Mail.Read. Do NOT request Mail.ReadWrite or Mail.Send.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# --- Google Cloud OAuth client (loopback authorization-code flow) ---
# Only needed for --provider gmail. In Google Cloud Console: enable the Gmail API,
# configure the OAuth consent screen (External, Testing is fine for personal use,
# add your own Gmail address as a test user), then create an OAuth client ID of
# type "Desktop app". (NOT "TVs and Limited Input devices" — Google's device-code
# flow doesn't support Gmail scopes at all, only openid/email/profile/Drive/YouTube.)
# Grant only the read-only scope: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM used for email classification ---
# "openai" (default) or "deepseek". DeepSeek is OpenAI-API-compatible and much
# cheaper, but only supports plain JSON mode (no strict schema enforcement) —
# see the comment in src/email/classify.ts for how that's handled.
LLM_PROVIDER=openai

# Used when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Used when LLM_PROVIDER=deepseek. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional overrides — leave blank to use the provider's default
# (OpenAI: gpt-4o-mini / api.openai.com; DeepSeek: deepseek-v4-flash / api.deepseek.com).
# For DeepSeek, deepseek-v4-pro trades cost for quality if you want to try it.
LLM_MODEL=
LLM_BASE_URL=
